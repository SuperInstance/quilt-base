# =============================================================================
# Quilt Base - .gitignore
# =============================================================================
# Ignore patterns for the quilt-base repository.
# This file is intentionally comprehensive: quilt-base is a public repository
# consumed via OCI image pulls, so the on-disk content should always be
# reproducible from the Dockerfile + scripts in this repo.
# =============================================================================

# -----------------------------------------------------------------------------
# OS / Editor cruft
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Vim / Emacs / Nano
*.swp
*.swo
*~
.\#*
\#*\#
*.bak
*.orig
*.rej
*.tmp

# VS Code / JetBrains / Sublime
.vscode/
.idea/
*.iml
*.sublime-project
*.sublime-workspace
.history/
.cursor/
.aider*
*.code-workspace

# -----------------------------------------------------------------------------
# Node / TypeScript (used by the build/test tooling around the Dockerfiles)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.pnp.*
.yarn/
*.tsbuildinfo
coverage/
.nyc_output/
.nycrc.lock

# -----------------------------------------------------------------------------
# Build / dist artifacts (we publish images, not binaries, from this repo)
# -----------------------------------------------------------------------------
dist/
build/
out/
target/
*.tgz
*.tar.gz
*.tar
*.zip
*.whl

# -----------------------------------------------------------------------------
# Docker / OCI artifacts
# -----------------------------------------------------------------------------
# Local images built by `scripts/build-all.sh` (tagged but not committed)
docker-image-*.tar
docker-image-*.tar.gz
*.dockerfile.local
# Leftover BuildKit cache exports
buildkit-cache-*.bin

# -----------------------------------------------------------------------------
# SBOM / vulnerability scan output
# -----------------------------------------------------------------------------
# Generated by `scripts/sbom-generate.sh` and the CVE scan workflows.
# We publish these as workflow artifacts instead.
sbom/
*.spdx.json
*.spdx
*.cdx.json
sbom-*.json
trivy-report.*
grype-report.*
sarif-report.*
*.sarif

# -----------------------------------------------------------------------------
# Secrets / local config
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/
.github/secrets.*

# -----------------------------------------------------------------------------
# CI / runner ephemeral
# -----------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
logs/
*.log

# -----------------------------------------------------------------------------
# Test artifacts
# -----------------------------------------------------------------------------
test-results/
junit.xml
playwright-report/
playwright/.cache/

# -----------------------------------------------------------------------------
# Quilt-specific local dev (when agents run this repo from a parent quilt)
# -----------------------------------------------------------------------------
.claude/
.quilt/
.agent-state/
